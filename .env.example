DATABASE_URL="postgresql://studymate:studymate_dev@localhost:5432/studymate?schema=public"
PORT=3000
APP_TIMEZONE="Europe/Budapest"

# Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Public base URL of the API; login links point here.
APP_URL="http://localhost:3000"
# e.g. smtps://user:password@smtp.example.com:465 — when empty (development only),
# login links are printed in the API console instead of being emailed.
SMTP_URL=""
# Development only: "true" also returns the login link in the request-link response,
# as devLoginLink. Ignored when NODE_ENV=production.
DEV_SHOW_LOGIN_LINK="false"
MAIL_FROM="StudyMate <no-reply@studymate.local>"

WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
GOOGLE_CLIENT_ID=""
